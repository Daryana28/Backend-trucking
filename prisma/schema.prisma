generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Truck {
  id          String       @id @default(cuid())
  plate       String       @unique
  alias       String?
  routes      Route[]
  truckUsages TruckUsage[]
}

model TruckUsage {
  id        String   @id @default(cuid())
  driverId  String
  truckId   String
  lat       Float?
  lng       Float?
  speed     Float?
  heading   Float?
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver   @relation(fields: [driverId], references: [id])
  truck     Truck    @relation(fields: [truckId], references: [id])
}

model Route {
  id             String   @id @default(cuid())
  driverId       String
  truckId        String
  originLat      Float?
  originLng      Float?
  destinationLat Float?
  destinationLng Float?
  createdAt      DateTime @default(now())
  driver         Driver   @relation(fields: [driverId], references: [id])
  truck          Truck    @relation(fields: [truckId], references: [id])
}

model Otp {
  phone String @id
  otp   String
}

model Driver {
  id          String         @id @default(cuid())
  name        String
  phone       String         @unique
  password    String
  statuses    DriverStatus[]
  routes      Route[]
  truckUsages TruckUsage[]
}

model DriverStatus {
  driverId    String
  plate       String?
  destination String?
  etdTime     String?
  etaTime     String?
  updatedAt   DateTime @updatedAt
  id          String   @id @default(cuid())
  direction   String?
  isFinished  Boolean  @default(false)
  tripGroup   String
  origin      String?
  heading     Float?
  lat         Float?
  lng         Float?
  speed       Float?
  driver      Driver   @relation(fields: [driverId], references: [id])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

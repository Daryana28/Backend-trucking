generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Truck {
  id          String       @id @default(cuid())
  plate       String       @unique
  alias       String?
  routes      Route[]
  truckUsages TruckUsage[]
}

model TruckUsage {
  id        String   @id @default(cuid())
  driverId  String
  truckId   String
  lat       Float?
  lng       Float?
  speed     Float?
  heading   Float?
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver   @relation(fields: [driverId], references: [id])
  truck     Truck    @relation(fields: [truckId], references: [id])
}

model Route {
  id             String   @id @default(cuid())
  driverId       String
  truckId        String
  originLat      Float?
  originLng      Float?
  destinationLat Float?
  destinationLng Float?
  createdAt      DateTime @default(now())
  driver         Driver   @relation(fields: [driverId], references: [id])
  truck          Truck    @relation(fields: [truckId], references: [id])
}

model Otp {
  phone String @id
  otp   String
}

model Driver {
  id          String         @id @default(cuid())
  name        String
  phone       String         @unique
  password    String
  statuses    DriverStatus[]
  routes      Route[]
  truckUsages TruckUsage[]
}

model DriverStatus {
  driverId      String
  plate         String?
  destination   String?
  etdTime       String?
  etaTime       String?
  updatedAt     DateTime @updatedAt
  id            String   @id @default(cuid())
  direction     String?
  isFinished    Boolean  @default(false)
  tripGroup     String
  origin        String?
  heading       Float?
  lat           Float?
  lng           Float?
  speed         Float?
  driver        Driver   @relation(fields: [driverId], references: [id])

  // ✅ NEW: tanggal delivery dari mobile (format: "YYYY-MM-DD")
  deliveryDate  String?

  @@index([driverId, tripGroup])
  @@index([deliveryDate])
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model PlanDaily {
  id          Int      @id @default(autoincrement())
  deliveryDate String   // format: YYYY-MM-DD
  destination  String
  group        String?
  tripNo       Int      @default(1)
  tripCount    Int      @default(0)

  forwardEtd   String?
  forwardEta   String?
  reverseEtd   String?
  reverseEta   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([deliveryDate, destination, tripNo], name: "uniq_plan_daily_date_destination_tripNo")
  @@index([deliveryDate])
  @@index([destination])
}

model ActualTripDaily {
  id           String   @id @default(cuid())
  deliveryDate String   // format: YYYY-MM-DD
  plate        String
  tripCount    Int      @default(0)
  nearStops    Int      @default(0)
  targetLat    Float?
  targetLng    Float?
  radiusM      Int?
  cooldownMin  Int?
  lastSyncAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stops        ActualTripStop[]
  raw          ActualTripRaw?
  events       ActualTripEvent[]

  @@unique([deliveryDate, plate], name: "uniq_actual_trip_daily")
  @@index([deliveryDate])
  @@index([plate])
}

model ActualTripStop {
  id           String   @id @default(cuid())
  dailyId      String
  plate        String
  deliveryDate String
  stopNo       Int?
  lat          Float?
  lng          Float?
  startSec     Int?
  endSec       Int?
  durationSec  Int?
  address      String?
  isNear       Boolean  @default(false)
  distM        Float?
  createdAt    DateTime @default(now())

  daily        ActualTripDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@index([deliveryDate])
  @@index([plate])
}

model ActualTripEvent {
  id             String   @id @default(cuid())
  dailyId        String
  plate          String
  deliveryDate   String
  type           String   // DRIVE / STOP
  stopNo         Int?
  lat            Float?
  lng            Float?
  startSec       Int?
  endSec         Int?
  durationSec    Int?
  distanceMeters Int?
  address        String?
  createdAt      DateTime @default(now())

  daily          ActualTripDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@index([deliveryDate])
  @@index([plate])
}

model ActualTripRaw {
  id           String   @id @default(cuid())
  dailyId      String   @unique
  plate        String
  deliveryDate String
  source       String   @default("accugps")
  payload      String   @db.NVarChar(Max)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  daily        ActualTripDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([deliveryDate, plate], name: "uniq_actual_trip_raw")
  @@index([deliveryDate])
  @@index([plate])
}
